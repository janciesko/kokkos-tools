# Minimal Lennard-Jones input for Kokkos Tools LAMMPS sanity checks.
# Use with: lmp -in in.lj.short -k on -sf kk [backend flags]
# Same problem as the standard LAMMPS in.lj benchmark, shortened to 50 steps.

units           lj
atom_style      atomic

lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0

velocity        all create 1.44 87287 loop geom

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 0 every 20 check no

fix             1 all nve

run             50
